{
  "name": "fomo-bot-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test-backend.mjs && node scripts/test-core.mjs",
    "doctor": "node --env-file-if-exists=.env dist/src/cli.js doctor",
    "feed": "node --env-file-if-exists=.env dist/src/cli.js feed",
    "vault:create": "node --env-file-if-exists=.env dist/src/cli.js vault-create"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "overrides": { "jayson": "5.0.0" }
}
